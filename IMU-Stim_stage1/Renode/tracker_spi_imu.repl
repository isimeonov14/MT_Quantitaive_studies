sysbus:
    init:
        Tag <0x10000000 0x10000000> "qspi"
        Tag <0x10000 0x40000> "slot0_partition"
        Tag <0x80000 0x40000> "slot1_partition"
        Tag <0x20000000 0x40000> "sram0_s"
        Tag <0x20040000 0x40000> "sram0_ns / sram0_ns_app / sram0_shared"
        Tag <0x50000 0x30000> "slot0_ns_partition"
        Tag <0xc0000 0x30000> "slot1_ns_partition"
        Tag <0x0 0x10000> "boot_partition / boot_mode0 / vregmain / vregradio / vregh"
        Tag <0xf8000 0x8000> "storage_partition"
        Tag <0xf0000 0x4000> "tfm_ps_partition"
        Tag <0xf4000 0x2000> "tfm_its_partition"
        Tag <0xf6000 0x2000> "tfm_otp_partition"
        Tag <0xff0000 0x1000> "ficr"
        Tag <0xff8000 0x1000> "uicr"
        Tag <0x4002f000 0x1000> "gpiote1"
        Tag <0x50000000 0x1000> "dcnf"
        Tag <0x50003000 0x1000> "spu"
        Tag <0x50004000 0x1000> "oscillators / regulators"
        Tag <0x50005000 0x1000> "power / reset / gpregret1 / gpregret2"
        Tag <0x50006000 0x1000> "ctrlap"
        Tag <0x50008000 0x1000> "spi0 / i2c0 / uart0"
        Tag <0x50009000 0x1000> "spi1 / i2c1 / uart1"
        Tag <0x5000a000 0x1000> "spi4"
        Tag <0x5000b000 0x1000> "spi2 / i2c2 / uart2"
        Tag <0x5000c000 0x1000> "spi3 / i2c3 / uart3"
        Tag <0x5000d000 0x1000> "gpiote"
        Tag <0x5000e000 0x1000> "adc"
        Tag <0x5000f000 0x1000> "timer0"
        Tag <0x50010000 0x1000> "timer1"
        Tag <0x50011000 0x1000> "timer2"
        Tag <0x50017000 0x1000> "dppic0"
        Tag <0x50018000 0x1000> "wdt"
        Tag <0x50019000 0x1000> "wdt1"
        Tag <0x5001a000 0x1000> "comp"
        Tag <0x5001b000 0x1000> "egu0"
        Tag <0x5001c000 0x1000> "egu1"
        Tag <0x5001d000 0x1000> "egu2"
        Tag <0x5001e000 0x1000> "egu3"
        Tag <0x5001f000 0x1000> "egu4"
        Tag <0x50020000 0x1000> "egu5"
        Tag <0x50021000 0x1000> "pwm0"
        Tag <0x50022000 0x1000> "pwm1"
        Tag <0x50023000 0x1000> "pwm2"
        Tag <0x50024000 0x1000> "pwm3"
        Tag <0x50026000 0x1000> "pdm0"
        Tag <0x50028000 0x1000> "i2s0"
        Tag <0x5002a000 0x1000> "mbox"
        Tag <0x5002b000 0x1000> "qspi"
        Tag <0x5002d000 0x1000> "nfct"
        Tag <0x50030000 0x1000> "mutex"
        Tag <0x50033000 0x1000> "qdec0"
        Tag <0x50034000 0x1000> "qdec1"
        Tag <0x50039000 0x1000> "kmu / flash_controller"
        Tag <0x50081000 0x1000> "vmc"
        Tag <0x50844000 0x1000> "cryptocell"
        Tag <0x50845000 0x1000> "cryptocell"
        Tag <0xe0000000 0x1000> "itm"
        Tag <0xe000ed90 0x40> "mpu"
        Tag <0xe000e010 0x10> "systick"

flash0: Memory.MappedMemory @ sysbus 0x0
    size: 0x100000

sram0image_sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x80000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m33"
    nvic: nvic0

clock: Miscellaneous.NRF_CLOCK @ sysbus 0x50005000
    ->nvic0@5

rtc0: Timers.NRF52840_RTC @ sysbus 0x50014000
    numberOfEvents: 4
    ->nvic0@20

rtc1: Timers.NRF52840_RTC @ sysbus 0x50015000
    numberOfEvents: 4
    ->nvic0@21

uart0: UART.NRF52840_UART @ sysbus 0x50008000
    easyDMA: true
    -> nvic0@8

gpio0: GPIOPort.NRF52840_GPIO @ sysbus 0x50842500

gpio1: GPIOPort.NRF52840_GPIO @ sysbus 0x50842800

gpiote: GPIOPort.NRF52840_GPIOTasksEvents @ sysbus 0x5000D000
    port0: gpio0
    port1: gpio1
    -> nvic0@13

spi3: Antmicro.Renode.Peripherals.SPI.NRF5340_SPI_CS @ sysbus 0x5000C000
    preinit:
        include @NRF5340_SPI_CS.cs
    easyDMA: true
    ExternalCSControlsTransactionBoundary: true
    -> nvic0@12

imu: Antmicro.Renode.Peripherals.Sensors.LSM6DSV16BX_SmartVNS @ spi3
    preinit:
        include @LSM6DSV16BX_SmartVNS_Replay.cs

    ChipSelectActiveLow: true
    DeselectedTransmitValue: 0xFF
    DeterministicSequenceSamples: false
    RandomizeDefaultSamples: false

    [Interrupt1, Interrupt2] -> gpio0@[23, 4]

gpio0:
    5 -> imu@0

ficr: Memory.MappedMemory @ sysbus 0xFF0000
    size: 0x1000

uicr: Memory.MappedMemory @ sysbus 0xFF8000
    size: 0x1000

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000
